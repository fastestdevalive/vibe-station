# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Build outputs
apps/web/dist-node/
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg
target/

# Rust
# target/ above already covers desktop/src-tauri/target/ — no duplicate needed.
# rust/target/ is explicit for clarity (also covered by the bare `target/` above).
rust/target/
# rust/target-docker/ — a one-off containerized release build (built inside
# node:24-slim to match the dev-sandbox's glibc, since a host-built binary
# can hit `GLIBC_x.xx not found` inside the container). Not a standard build
# location; kept out of git the same as rust/target/.
rust/target-docker/
# rust/target-bookworm/ — same reason as rust/target-docker/ above, built via
# `rust:slim-bookworm` to match the dev-sandbox's Debian bookworm base image.
rust/target-bookworm/
# *.rs.bk are backup files left by rustfmt.
*.rs.bk
# Gate logs (rust/.gate/<part>.log) are a committed deliverable — the bare
# `*.log` above would otherwise ignore them.
!rust/.gate/
!rust/.gate/*.log
# Cargo.lock SHOULD be committed for applications (not libraries); do NOT add it here.
# Tauri auto-generated capability schemas — regenerated by cargo tauri dev/build.
desktop/src-tauri/gen/

