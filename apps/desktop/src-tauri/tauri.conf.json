{
  "productName": "vibe-station",
  "version": "0.1.0",
  "identifier": "com.fastestdevalive.vibestation",
  "build": {
    "beforeDevCommand": "pnpm --filter web-ui dev -- --port 5180",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "pnpm --filter web-ui build",
    "frontendDist": "../../../web-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "vibe-station",
        "width": 1400,
        "height": 900,
        "minWidth": 700,
        "minHeight": 500,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 10, "y": 10 }
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/vst-daemon", "binaries/cloudflared"],
    "macOS": {
      "entitlements": "entitlements.mac.plist",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
