SCHEMA_VERSION = 1


def git(*args):
    try:
        return subprocess.run(["git", "-C", HERE, *args], capture_output=True, text=True, timeout=10).stdout.strip()
    except Exception:
        return ""


def emit(doc, a):
    """Write results/<name>.json next to this script (override with --json)."""
    m = doc["machine"]
    noisy = m["loadavg"][0] > a.max_load or (m.get("swap_used_mb") or 0) > 1024
    meta = {
        "schema_version": SCHEMA_VERSION,
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "commit": git("rev-parse", "HEAD"),
        "dirty": bool(git("status", "--porcelain", "--untracked-files=no", "--", ":/", ":(exclude)benchmarks/results")),
        "binary_sha256": hashlib.sha256(open(a.bin, "rb").read()).hexdigest()[:16],
        # website: show only runs with preliminary == false
        "preliminary": noisy,
    }
    doc = {**meta, **doc}
    s = json.dumps(doc, indent=2)
    out = a.json or os.path.join(HERE, "results", RESULT_NAMES[doc["part"]] + ".json")
    os.makedirs(os.path.dirname(out), exist_ok=True)
    open(out, "w").write(s + "\n")
    print(f"wrote {out}", file=sys.stderr)


def main():
    ap = argparse.ArgumentParser(prog="vstbench", description=__doc__, formatter_class=argparse.RawTextHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def common(p, runs=5):
        p.add_argument("--bin", required=True, help="path to release `vst` binary (embed-ui build)")
        p.add_argument("--port", type=int, default=7900)
        p.add_argument("--runs", type=int, default=runs)
        p.add_argument("--settle", type=float, default=15)
        p.add_argument("--max-load", type=float, default=2.0)
        p.add_argument("--force", action="store_true", help="ignore the load-average guard (results flagged noisy)")
        p.add_argument("--json")

    p = sub.add_parser("footprint"); common(p)
    p.add_argument("--competitors", action="store_true"); p.add_argument("--repo")
    p.add_argument("--cs-port", type=int, default=7901); p.add_argument("--cpu-window", type=float, default=20)
    p.set_defaults(fn=cmd_footprint)
    p = sub.add_parser("editors"); common(p); p.add_argument("--repo", required=True)
    p.add_argument("--tools", default="zed,sublime", help="comma list of: zed,sublime,codeserver")
    p.add_argument("--cs-port", type=int, default=7901); p.set_defaults(fn=cmd_editors)
    p = sub.add_parser("startup"); common(p, 30)
    p.add_argument("--baseline", required=True, help="binary to compare against (the 'before' arm)")
    p.add_argument("--warmup", type=int, default=2); p.set_defaults(fn=cmd_startup)
    p = sub.add_parser("scale"); common(p, 1); p.add_argument("--counts", default="0,14,50"); p.set_defaults(fn=cmd_scale)
    p = sub.add_parser("trace"); common(p, 1)
    p.add_argument("--duration", type=float, default=15); p.add_argument("--idle", type=float, default=30)
    p.set_defaults(fn=cmd_trace)
    p = sub.add_parser("load"); common(p, 3); p.add_argument("--duration", type=float, default=15); p.set_defaults(fn=cmd_load)
    p = sub.add_parser("corpus"); common(p, 5)
    p.add_argument("--dir", default="bench-repos"); p.add_argument("--only"); p.set_defaults(fn=cmd_corpus)
    p = sub.add_parser("fetch"); p.add_argument("--dir", default="bench-repos"); p.add_argument("--only")
    p.set_defaults(fn=cmd_fetch)
    a = ap.parse_args()
    if a.cmd != "fetch":
        ensure_netns()
        check_no_cloudflared(a.force)
    a.fn(a)


if __name__ == "__main__":
    main()
