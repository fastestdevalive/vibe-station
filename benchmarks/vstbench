def cmd_fetch(a):
    os.makedirs(a.dir, exist_ok=True)
    for name in (a.only.split(",") if a.only else CORPUS):
        url = CORPUS[name][0]
        dest = os.path.join(a.dir, name)
        if os.path.isdir(dest):
            print(f"skip {name} (exists)", file=sys.stderr)
            continue
        subprocess.run(["git", "clone", "--depth", "1", "-q", url, dest], check=True)
        print(f"cloned {name}", file=sys.stderr)


def cmd_corpus(a):
    check_quiet(a.max_load, a.force)
    rows = []
    for name in (a.only.split(",") if a.only else CORPUS):
        repo = os.path.abspath(os.path.join(a.dir, name))
        if not os.path.isdir(repo):
            print(f"skip {name} (not cloned)", file=sys.stderr)
            continue
        files = int(subprocess.run(["git", "-C", repo, "ls-files"], capture_output=True, text=True).stdout.count("\n"))
        with Daemon(a.bin, a.port) as d:
            st, pid, _ = d.register_repo(repo, name)
            if st >= 300 or not pid:
                rows.append({"repo": name, "error": f"register failed {st}"})
                continue
            row = {"repo": name, "files": files}
            st, fl, ms = d.api(f"/projects/{pid}/file-list")
            row["file_list_cold_ms"] = round(ms, 1)
            if isinstance(fl, dict):
                row["file_list_returned"] = len(fl.get("files", []))
                row["file_list_truncated"] = fl.get("truncated")
                row["file_list_source"] = fl.get("source")
            warm = [d.api(f"/projects/{pid}/file-list")[2] for _ in range(a.runs)]
            row["file_list_warm_ms"] = round(statistics.median(warm), 1)
            for key, q in (("content_search_ms", "func"), ("content_rare_ms", "zzqxjv_unlikely")):
                t = [d.api(f"/projects/{pid}/search?q={q}&limit=50")[2] for _ in range(a.runs)]
                row[key] = round(statistics.median(t), 1)
            row["idle_rss_mb"] = settle_sample(d.proc.pid, 3, 3)["rss_mb"]
            rows.append(row)
            print(row, file=sys.stderr)
    emit({"part": "B", "machine": machine_info(),
          "note": "project-level endpoints; fuzzy (worktree-scoped) not yet covered", "rows": rows}, a)


