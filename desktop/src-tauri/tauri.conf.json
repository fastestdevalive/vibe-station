{
  "productName": "vibe-station",
  "version": "0.0.0",
  "identifier": "com.fastestdevalive.vibestation",
  "build": {
    "beforeDevCommand": "bash ../scripts/dev-start.sh",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "bash ../scripts/prep-sidecar.sh && pnpm --filter @vibestation/web build",
    "frontendDist": "../../web-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "vibe-station",
        "width": 1400,
        "height": 900,
        "minWidth": 700,
        "minHeight": 500,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 10, "y": 10 }
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/vst-daemon", "binaries/cloudflared", "binaries/vst"],
    "resources": ["../../skill/SKILL.md"],
    "macOS": {
      "entitlements": "entitlements.mac.plist",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
