{
  "name": "vibe-station",
  "version": "0.0.0",
  "private": true,
  "description": "Web-based orchestrator for parallel AI coding agents.",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter @vibe-station/desktop dev",
    "build": "pnpm --filter @vibe-station/desktop build",
    "build:rust": "cargo build --release --manifest-path rust/Cargo.toml -p vst-daemon -p vst-cli",
    "docker": "VST_SANDBOX_PORT=${VST_SANDBOX_PORT:-7100} bash scripts/dev-sandbox.sh up",
    "lint": "eslint web-ui/src web-ui/e2e",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @vibestation/web test:e2e",
    "ci": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.70.0",
    "@agentclientprotocol/sdk": "1.4.0",
    "@eslint/js": "^9.15.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/type-provider-zod": "^1.0.0",
    "@fastify/websocket": "^11.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "20",
    "@types/prompts": "^2.4.9",
    "@types/ws": "^8.18.1",
    "@yao-pkg/pkg": "^5.16.0",
    "better-sqlite3": "12",
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fastify": "5",
    "ignore": "^7.0.5",
    "nock": "^13.5.4",
    "node-pty": "^1.1.0",
    "ora": "^8.0.1",
    "prompts": "^2.4.2",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "2",
    "ws": "^8.20.0",
    "zod": "^4.4.2"
  }
}
